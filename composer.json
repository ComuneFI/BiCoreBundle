{
    "name": "fi/bicorebundle",
    "description": "Bootstrap italia CoreBundle by Comune Di Firenze",
    "type": "symfony-bundle",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "authors": [{
            "name": "Andrea Manzi",
            "email": "andrea.manzi@comune.fi.it"
        },
        {
            "name": "Emidio Picariello",
            "email": "emidio.picariello@comune.fi.it"
        },
        {
            "name": "Angela Bianchi",
            "email": "angela.bianchi@comune.fi.it"
        },
        {
            "name": "Lisa Pescini",
            "email": "lisa.pescini@comune.fi.it"
        },
        {
            "name": "Paolo Pescini",
            "email": "paolo.pescini@comune.fi.it"
        }],
    "keywords": [
        "bicorebundle bootstrapitalia jquery bootstrap"
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Cdf\\BiCoreBundle\\": "src/Cdf/BiCoreBundle",
            "Cdf\\PannelloAmministrazioneBundle\\": "src/Cdf/PannelloAmministrazioneBundle"
        }
    },
    "autoload-dev": {   
        "psr-4": {
            "App\\": "src/"
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://satis.comune.intranet",
            "canonical": false,
            "options": {
                "ssl": {
                    "verify_peer": true,
                    "allow_self_signed": true,
                    "local_cert": "~/.satiscerts/satis.comune.intranet.cer"
                }
            }       
        }
    ],
    "require": {
        "php": "~8.3",
        "composer/package-versions-deprecated": "^1.11",
        "comunedifirenze/doctrine2-exporter": "^3.0",
        "comunedifirenze/mysql-workbench-schema-exporter": "^3.0",
        "doctrine/doctrine-bundle": "^2.4",
        "doctrine/doctrine-migrations-bundle": "^3.1",
        "doctrine/orm": "^3.0",
        "fi/osbundle": "6.4.*",
        "fi/user-bundle": "*",
        "friendsofsymfony/jsrouting-bundle": "^3.0",
        "hanneskod/classtools": "*",
        "phpoffice/phpspreadsheet": "^1.4",
        "symfony/asset": "6.4.*",
        "symfony/cache": "6.4.*",
        "symfony/console": "6.4.*",
        "symfony/dependency-injection": "^6.4",
        "symfony/dotenv": "6.4.*",
        "symfony/error-handler": "6.4.*",
        "symfony/event-dispatcher": "6.4.*",
        "symfony/finder": "^6.4",
        "symfony/flex": "^1.0|^2.0",
        "symfony/form": "6.4.*",
        "symfony/framework-bundle": "^6.4",
        "symfony/http-foundation": "6.4.*",
        "symfony/http-kernel": "6.4.*",
        "symfony/lock": "6.4.*",
        "symfony/mailer": "6.4.*",
        "symfony/maker-bundle": "^1.7",
        "symfony/mime": "6.4.*",
        "symfony/monolog-bundle": "^3.2",
        "symfony/options-resolver": "6.4.*",
        "symfony/password-hasher": "6.4.*",
        "symfony/process": "6.4.*",
        "symfony/property-access": "6.4.*",
        "symfony/property-info": "6.4.*",
        "symfony/proxy-manager-bridge": "6.4.*",
        "symfony/routing": "6.4.*",
        "symfony/runtime": "6.4.*",
        "symfony/security-csrf": "6.4.*",
        "symfony/string": "6.4.*",
        "symfony/translation": "6.4.*",
        "symfony/twig-bridge": "6.4.*",
        "symfony/var-exporter": "6.4.*",
        "symfony/webpack-encore-bundle": "^1.5",
        "symfony/yaml": "6.4.*"
    },
    "require-dev": {
        "dbrekelmans/bdi": "^1.0.0",
        "phpmd/phpmd": "^2.6",
        "scrutinizer/ocular": "^1.8",
        "squizlabs/php_codesniffer": "^3.3",
        "symfony/browser-kit": "6.4.*",
        "symfony/css-selector": "6.4.*",
        "symfony/panther": "^1.0.0|^2.0.0",
        "symfony/stopwatch": "6.4.*",
        "symfony/var-dumper": "6.4.*",
        "symfony/web-profiler-bundle": "6.4.*"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "suggest": {
        "ext-apcu": "The extension required to use cache"
    },
    "scripts": {
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "replace": {
        "paragonie/random_compat": "2.*",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php71": "*",
        "symfony/polyfill-php70": "*",
        "symfony/polyfill-php56": "*"
    },
    "bin": ["check-src"],
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "6.4.*"
        },
        "branch-alias": {
            "dev-master": "6.4.x-dev"
        }
    },
    "_comment" : "rector/rector: *"
        
}
